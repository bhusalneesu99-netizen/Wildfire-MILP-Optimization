   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import pulp\n",
    "\n",
    "# ============================================================\n",
    "# Example MILP script for selecting treatment units to minimize\n",
    "# landscape-level fire risk under an area budget constraint\n",
    "# ============================================================\n",
    "\n",
    "# -----------------------------\n",
    "# USER-DEFINED PARAMETERS\n",
    "# -----------------------------\n",
    "risk_reduction = 0.05      # proportional reduction in risk if treated\n",
    "risk_increase = 0.01       # proportional increase in risk if untreated\n",
    "treatment_fraction = 0.10  # maximum fraction of total landscape area treated\n" as you want ......,
    "\n",
    "# -----------------------------\n",
    "# INPUT DATA\n",
    "# -----------------------------\n",
    "# Required dataframe columns:\n",
    "#   unit_id    : unique identifier for each management unit\n",
    "#   area_ha    : area of each unit\n",
    "#   risk_base  : baseline fire risk value\n",
    "#\n",
    "# Example:\n",
    "# df = pd.read_csv(\"input_units.csv\")\n",
    "\n",
    "required_cols = [\"unit_id\", \"area_ha\", \"risk_base\"]\n",
    "missing_cols = [c for c in required_cols if c not in df.columns]\n",
    "if missing_cols:\n",
    "    raise ValueError(f\"Missing required columns: {missing_cols}\")\n",
    "\n",
    "df = df.copy()\n",
    "df[\"area_ha\"] = df[\"area_ha\"].astype(float)\n",
    "df[\"risk_base\"] = df[\"risk_base\"].astype(float)\n",
    "\n",
    "# -----------------------------\n",
    "# LANDSCAPE PARAMETERS\n",
    "# -----------------------------\n",
    "total_landscape_area = float(df[\"area_ha\"].sum())\n",
    "area_budget = treatment_fraction * total_landscape_area\n",
    "\n",
    "units = df[\"unit_id\"].tolist()\n",
    "area = dict(zip(df[\"unit_id\"], df[\"area_ha\"]))\n",
    "risk0 = dict(zip(df[\"unit_id\"], df[\"risk_base\"]))\n",
    "\n",
    "# -----------------------------\n",
    "# MODEL DEFINITION\n",
    "# -----------------------------\n",
    "model = pulp.LpProblem(\"Minimize_Landscape_Fire_Risk\", pulp.LpMinimize)\n",
    "\n",
    "# Binary decision variable:\n",
    "# x[i] = 1 if unit i is treated, 0 otherwise\n",
    "x = pulp.LpVariable.dicts(\"Treat\", units, lowBound=0, upBound=1, cat=pulp.LpBinary)\n",
    "\n",
    "# -----------------------------\n",
    "# OBJECTIVE FUNCTION\n",
    "# -----------------------------\n",
    "# Minimize area-weighted post-treatment fire risk:\n",
    "#\n",
    "# If treated:    risk = risk0 * (1 - risk_reduction)\n",
    "# If untreated:  risk = risk0 * (1 + risk_increase)\n",
    "\n",
    "objective = pulp.lpSum(\n",
    "    area[i] * (\n",
    "        risk0[i] * (1.0 + risk_increase)\n",
    "        - risk0[i] * (risk_reduction + risk_increase) * x[i]\n",
    "    )\n",
    "    for i in units\n",
    ")\n",
    "\n",
    "model += objective\n",
    "\n",
    "# -----------------------------\n",
    "# CONSTRAINT: treatment area budget\n",
    "# -----------------------------\n",
    "model += pulp.lpSum(area[i] * x[i] for i in units) <= area_budget, \"AreaBudget\"\n",
    "\n",
    "# -----------------------------\n",
    "# SOLVE MODEL\n",
    "# -----------------------------\n",
    "solver = pulp.PULP_CBC_CMD(msg=True)\n",
    "model.solve(solver)\n",
    "\n",
    "print(\"Solver status:\", pulp.LpStatus[model.status])\n",
    "\n",
    "# -----------------------------\n",
    "# RESULTS\n",
    "# -----------------------------\n",
    "if pulp.LpStatus[model.status] == \"Optimal\":\n",
    "\n",
    "    df[\"treated\"] = df[\"unit_id\"].map(lambda i: int(pulp.value(x[i]) > 0.5))\n",
    "    df[\"decision\"] = df[\"treated\"].map({1: \"Treat\", 0: \"No treatment\"})\n",
    "\n",
    "    df[\"risk_after\"] = np.where(\n",
    "        df[\"treated\"] == 1,\n",
    "        df[\"risk_base\"] * (1.0 - risk_reduction),\n",
    "        df[\"risk_base\"] * (1.0 + risk_increase)\n",
    "    )\n",
    "\n",
    "    df[\"treated_area\"] = df[\"treated\"] * df[\"area_ha\"]\n",
    "\n",
    "    # Landscape metrics\n",
    "    landscape_risk_before = float((df[\"area_ha\"] * df[\"risk_base\"]).sum())\n",
    "    landscape_risk_after = float((df[\"area_ha\"] * df[\"risk_after\"]).sum())\n",
    "\n",
    "    weighted_mean_before = landscape_risk_before / total_landscape_area\n",
    "    weighted_mean_after = landscape_risk_after / total_landscape_area\n",
    "\n",
    "    print(\"\\n=== OPTIMIZATION RESULTS ===\")\n",
    "    print(\"Objective value:\", float(pulp.value(model.objective)))\n",
    "    print(\"Total landscape area:\", total_landscape_area)\n",
    "    print(\"Treatment budget:\", area_budget)\n",
    "    print(\"Total treated area:\", float(df[\"treated_area\"].sum()))\n",
    "    print(\"Number of treated units:\", int(df[\"treated\"].sum()))\n",
    "    print(\"Landscape risk before:\", landscape_risk_before)\n",
    "    print(\"Landscape risk after:\", landscape_risk_after)\n",
    "    print(\"Area-weighted mean risk before:\", weighted_mean_before)\n",
    "    print(\"Area-weighted mean risk after:\", weighted_mean_after)\n",
    "\n",
    "    print(\"\\nSelected treatment units:\")\n",
    "    print(df[df[\"treated\"] == 1][\n",
    "        [\"unit_id\", \"area_ha\", \"risk_base\", \"risk_after\", \"treated\"]\n",
    "    ])\n",
    "\n",
    "    # Optional export\n",
    "    # df.to_excel(\"optimization_results.xlsx\", index=False)\n",
    "\n",
    "else:\n",
    "    print(\"Model did not solve optimally.\")"
   ]
  }
